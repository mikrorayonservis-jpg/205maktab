# ─── Qezet-205 Məktəb Platforması — mühit dəyişənləri ───
# Bu faylı .env adı ilə kopyalayın və dəyərləri doldurun. .env faylını heç vaxt paylaşmayın və git-ə əlavə etməyin.
# Vercel-də eyni adları Project → Settings → Environment Variables bölməsində təyin edin (docs/deployment/SUPABASE_VERCEL.md).

NODE_ENV=development
# Saytın ictimai ünvanı (e-poçt keçidləri, sitemap, canonical URL). https olduqda __Host- cookie və HSTS aktivləşir.
SITE_URL=http://localhost:3000

# ── Verilənlər bazası: Supabase Postgres (YALNIZ SERVER) ──
# Supabase Dashboard → Connect → "Transaction pooler" (port 6543) bağlantı sətri. Parol daxildir — gizli saxlayın.
# Nümunə forma: postgresql://postgres.<project-ref>:<DB-PAROLU>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Tövsiyə olunur: Supabase → Database Settings → SSL Configuration → "Download certificate" (PEM mətni).
# Verilərsə server sertifikatı tam yoxlanılır; verilməzsə bağlantı şifrələnir, lakin sertifikat yoxlanılmır.
# Bir sətirdə yazmaq üçün sətir sonlarını \n ilə əvəz edin.
DATABASE_CA_CERT=
# disable | require (boş: localhost üçün SSL-siz, digər ünvanlar üçün SSL məcburi)
DATABASE_SSL=
# Hər server instansiyası üçün bağlantı sayı (Vercel-də defolt 3, lokal 10)
DB_POOL_SIZE=

# İnteqrasiya testləri üçün AYRICA baza: lokal Postgres və ya adı "_test" ilə bitən baza (testlər bazanı təmizləyir!)
DATABASE_URL_TEST=

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://skijahzkjlzhejrzomai.supabase.co
# İctimai (publishable) açar. Hazırda tətbiq brauzerdən Supabase-ə müraciət etmir — bu açar kodda istifadə olunmur.
# Bazadakı bütün cədvəllər bu açara bağlıdır (RLS, 0008_row_level_security.sql).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# YALNIZ SERVER: Storage (fayl yükləmə/oxuma) üçün secret key (sb_secret_...). HEÇ VAXT NEXT_PUBLIC_ prefiksi ilə verməyin.
# Boş qalarsa fayllar lokal STORAGE_DIR qovluğunda saxlanılır (yalnız development; Vercel-də yükləmə işləməz).
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=school-files

# Lokal fayl saxlama qovluğu (SUPABASE_SECRET_KEY boş olduqda; public/ qovluğundan kənarda)
STORAGE_DIR=storage

# ── Qeydiyyat və parol siyasəti ──
# Parol siyasəti (gizli deyil, brauzerdə də yoxlanılır; dəyişiklik yeni build tələb edir):
#   strong — ən azı 10 simvol, böyük/kiçik hərf, rəqəm (defolt, production üçün tövsiyə)
#   digits — düz NEXT_PUBLIC_PASSWORD_DIGITS rəqəm (YALNIZ test mərhələsi üçün; zəif parollardır)
NEXT_PUBLIC_PASSWORD_POLICY=strong
NEXT_PUBLIC_PASSWORD_DIGITS=8
# Ümumi qeydiyyat kodu (YALNIZ SERVER; NEXT_PUBLIC_ prefiksi ilə verməyin). Kod yalnız qeydiyyata icazə verir:
# hesab rolsuz yaradılır, rolu administrator təyin edir. Boş qalsa yalnız fərdi dəvət kodları işləyir.
REGISTRATION_INVITE_CODE=
# 1 — ümumi kodla qeydiyyatda e-poçt təsdiqi tələb olunmur (SMTP hələ qurulmayıbsa, test üçün). Defolt: 0
REGISTRATION_AUTO_VERIFY=0

# Sessiya müddəti (gün) və parol bərpası keçidinin müddəti (dəqiqə)
SESSION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# Reverse proxy arxasındadırsa 1 — X-Forwarded-For IP üçün istifadə olunur (Vercel-də 1)
TRUST_PROXY=0

# SMTP (e-poçt təsdiqi və parol bərpası). Production-da MƏCBURİDİR: əks halda dəvətlə qeydiyyatdan keçənlər hesabı təsdiqləyə bilmir.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="205 nömrəli məktəb <no-reply@example.az>"

# Ehtiyat nüsxə (npm run backup) — pg_dump/pg_restore lazımdır (versiya Supabase Postgres-dən köhnə olmamalıdır)
BACKUP_DIR=backups
BACKUP_KEEP=14
# PG_DUMP_PATH="C:\\Program Files\\PostgreSQL\\17\\bin\\pg_dump.exe"
# PG_RESTORE_PATH="C:\\Program Files\\PostgreSQL\\17\\bin\\pg_restore.exe"

# Bir dəfəlik köçürmə (npm run db:copy-mysql): köhnə MySQL bazası (yalnız oxunur).
# Təyin edilməyibsə köhnə DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME dəyişənləri istifadə olunur.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
