# ─── Qezet-205 Məktəb Platforması — mühit dəyişənləri ───
# Bu faylı .env adı ilə kopyalayın və dəyərləri doldurun. .env faylını heç vaxt paylaşmayın.

NODE_ENV=development
# Saytın ictimai ünvanı (e-poçt keçidləri, sitemap, canonical URL)
SITE_URL=http://localhost:3000

# MySQL 8+
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_school
DB_USER=school_app
DB_PASSWORD=
# İnteqrasiya testləri üçün AYRICA baza (adı _test ilə bitməlidir)
DB_NAME_TEST=db_school_test
DB_POOL_SIZE=10

# Yüklənən fayllar (public/ qovluğundan kənarda saxlanılır)
STORAGE_DIR=storage

# Sessiya müddəti (gün) və parol bərpası keçidinin müddəti (dəqiqə)
SESSION_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60

# Reverse proxy (nginx/IIS) arxasındadırsa 1 — X-Forwarded-For IP üçün istifadə olunur
TRUST_PROXY=0

# SMTP (e-poçt təsdiqi və parol bərpası). Development-də boş qalsa keçidlər server konsoluna yazılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="205 nömrəli məktəb <no-reply@example.az>"

# Ehtiyat nüsxə
BACKUP_DIR=backups
BACKUP_KEEP=14
# MYSQLDUMP_PATH="C:\\Program Files\\MySQL\\MySQL Server 8.4\\bin\\mysqldump.exe"
# MYSQL_PATH="C:\\Program Files\\MySQL\\MySQL Server 8.4\\bin\\mysql.exe"
